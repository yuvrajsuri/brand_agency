# ─────────────────────────────────────────────
# Brand Agency — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Domain (Traefik SSL)
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ─── External APIs ───────────────────────────

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Image Generation
RUNWARE_API_KEY=your_runware_api_key_here
IMAGEN_MODEL=imagen-4.0-generate-001

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_custom_verify_token_here

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=brand-agency-creatives
R2_PUBLIC_DOMAIN=cdn.yourdomain.com

# Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── App Settings ────────────────────────────

# Admin WhatsApp for escalation alerts
ADMIN_PHONE=919876543210

# Quality audit settings
AUDIT_PASS_THRESHOLD=0.85
AUDIT_MAX_RETRIES=3

# Debug mode (set to false in production)
DEBUG=false
